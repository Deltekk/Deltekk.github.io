---
// Layout comune a tutte le pagine: metadati (anche per le anteprime dei link), header, contenuto e footer.
// Titolo e descrizione arrivano dalla voce di src/data/sito.ts con lo stesso percorso della pagina;
// una pagina può comunque passarli come props.
import "@/styles/starwind.css";
import Header from "@/components/sito/Header.astro";
import Footer from "@/components/sito/Footer.astro";
import logo from "@/assets/logo.svg";
import { SITO, paginaDi } from "@/data/sito";

interface Props {
  titolo?: string;
  descrizione?: string;
}

const pagina = paginaDi(Astro.url.pathname);
const { titolo = pagina?.titolo, descrizione = pagina?.descrizione ?? SITO.descrizione } = Astro.props;

const titoloCompleto = titolo ? `${titolo} · ${SITO.nome}` : SITO.nome;
const indirizzo = new URL(Astro.url.pathname, Astro.site);
const immagineAnteprima = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    <link rel="canonical" href={indirizzo} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href={logo.src} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Anteprima dei link (WhatsApp, Telegram, Discord, Facebook, LinkedIn...).
         L'immagine è public/og.png, esportata da src/assets/og.svg. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITO.nome} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:url" content={indirizzo} />
    <meta property="og:title" content={titoloCompleto} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:image" content={immagineAnteprima} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITO.nome}: progettini, esperimenti e pagine personali`} />
    <!-- X/Twitter legge titolo, descrizione e immagine dai tag Open Graph: serve solo il tipo di card -->
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Applica il tema scelto (o quello del sistema) prima che la pagina venga disegnata, senza lampi -->
    <script is:inline>
      (() => {
        let tema = null;
        try {
          tema = localStorage.getItem("tema");
        } catch {}
        const scuro = tema ? tema === "scuro" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", scuro);
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
