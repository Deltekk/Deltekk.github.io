---
// Footer comune: link alle pagine di src/data/sito.ts e al profilo GitHub
import { PAGINE, SITO } from "@/data/sito";
import BrandGithub from "@tabler/icons/outline/brand-github.svg";

const anno = new Date().getFullYear();
---

<footer class="border-t">
  <div class="text-muted-foreground mx-auto flex max-w-6xl flex-col items-center gap-4 px-6 py-8 text-sm sm:flex-row sm:justify-between">
    <p>© {anno} {SITO.nome} · Fatto con Astro, Tailwind e Starwind UI</p>
    <nav aria-label="Collegamenti" class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
      {PAGINE.map(({ percorso, menu }) => <a href={percorso} class="hover:text-foreground">{menu}</a>)}
      <a href={SITO.github} target="_blank" rel="noopener" class="hover:text-foreground flex items-center gap-1">
        <BrandGithub class="size-4" /> GitHub
      </a>
    </nav>
  </div>
</footer>
