---
// src/pages/wishlist.astro
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Card, CardHeader, CardTitle, CardDescription, CardContent, CardFooter, CardAction } from "@/components/starwind/card";
import { Input } from "@/components/starwind/input";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import { Prose } from "@/components/starwind/prose";
import { Select, SelectTrigger, SelectItem, SelectValue, SelectContent } from "@/components/starwind/select";
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from "@/components/starwind/accordion";

// ----- ICONE ------

import Vinyl from "@tabler/icons/outline/vinyl.svg";
import Disc from "@tabler/icons/outline/disc.svg";
import Book from "@tabler/icons/outline/book.svg";
import Books from "@tabler/icons/outline/books.svg";
import Gamepad from "@tabler/icons/outline/device-gamepad-2.svg";
import Dice from "@tabler/icons/outline/dice-5.svg";
import Movie from "@tabler/icons/outline/movie.svg";
import Plug from "@tabler/icons/outline/plug.svg";
import Cpu from "@tabler/icons/outline/cpu.svg";
import Package from "@tabler/icons/outline/package.svg";
import Tag from "@tabler/icons/outline/tag.svg";
import Search from "@tabler/icons/outline/search.svg";
import ExternalLink from "@tabler/icons/outline/external-link.svg";
import AlertTriangle from "@tabler/icons/outline/alert-triangle.svg";
import LayoutGrid from "@tabler/icons/outline/layout-grid.svg";
import Star from "@tabler/icons/outline/star.svg";
import Category from "@tabler/icons/outline/category.svg";
import SortAsc from "@tabler/icons/outline/sort-ascending-numbers.svg";
import SortDesc from "@tabler/icons/outline/sort-descending-numbers.svg";
import Stack from "@tabler/icons/outline/stack-2.svg";

const ordinamenti = [
  { value: "priorita", label: "Priorità", Icona: Star },
  { value: "categoria", label: "Categoria", Icona: Category },
  { value: "prezzo-asc", label: "Prezzo crescente", Icona: SortAsc },
  { value: "prezzo-desc", label: "Prezzo decrescente", Icona: SortDesc },
];

const icone: Record<string, typeof Tag> = {
  Vinili: Vinyl,
  Vinile: Vinyl,
  CD: Disc,
  Manga: Book,
  Libri: Books,
  Videogame: Gamepad,
  "Giochi da tavolo": Dice,
  BluRay: Movie,
  IOT: Plug,
  Elettronica: Cpu,
  Accessori: Package,
};
const iconaDi = (categoria: string) => icone[categoria] ?? Tag;

// ----- ----- -----

const wishlist = (await getCollection("wishlistGiovy")).sort(
	(a,b) => 
		a.data.priorità - b.data.priorità ||
		a.data.nome.localeCompare(b.data.nome, "it")
);

const categorie = [...new Set(wishlist.map((v) => v.data.categoria))]
  .sort((a, b) => a.localeCompare(b, "it"));

---
<Layout title="Wishlist">


	<section class="mx-auto max-w-sm md:max-w-5xl px-6 py-16 flex flex-col text-center items-center justify-center">

	<h1 class="w-full text-center text-3xl font-bold mb-10"> WISHLIST GIOVANNI </h1>

    <Accordion defaultValue="item-1" class="w-full">
		<AccordionItem value="item-1">
			<AccordionTrigger class="font-bold">
				<AlertTriangle class="size-4 text-red-500" />
				Disclaimer Generale
			</AccordionTrigger>
			<AccordionContent>
				<p class="w-full">
					<b class="text-red-500"> Disclaimer Generale:</b> Per la natura del sito, <b>i prezzi</b> che vedete sono <b>indicativi</b> e non aggiornati. Per quanto riguarda la scelta da fare, vi chiedo di basare la vostra decisione sulla <b> priorità degli item </b>. Infine, vi voglio chiedere di cerare cose di <b class="font-extrabold"> qualità, riparabili e manutenibili. </b>  
				</p>
			</AccordionContent>
		</AccordionItem>			
	</Accordion>

	<div class="my-8">

		<div class="flex flex-col md:flex-row w-full gap-x-5 gap-y-5 my-5">
			<div class="relative w-full">
				<Search class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" />
				<Input id="cerca" type="search" placeholder="Cerca nella wishlist..." class="pl-9" />
			</div>
			
			<div class="relative w-full md:w-1/3">
				{ordinamenti.map(({ value, Icona }) => (
					<span
					data-icona-ordina={value}
					hidden={value !== "priorita"}
					class="pointer-events-none absolute left-3 top-1/2 z-10 -translate-y-1/2"
					>
					<Icona class="size-4" />
					</span>
				))}

				<Select id="ordina" defaultValue="priorita" name="Ordina per...">
					<SelectTrigger class="w-full pl-9" placeholder="Ordina per" />
					<SelectContent>
					{ordinamenti.map(({ value, label, Icona }) => (
						<SelectItem value={value}>
						<span class="flex items-center gap-2"><Icona class="size-4" />{label}</span>
						</SelectItem>
					))}
					</SelectContent>
				</Select>
			</div>
		</div>

		<div class="my-2 flex flex-wrap gap-2">
			{["Tutte", ...categorie].map((c) => {
			const Icona = c === "Tutte" ? LayoutGrid : iconaDi(c);
			return (
				<Button
				variant="outline"
				size="sm"
				data-filtro={c === "Tutte" ? "" : c}
				aria-pressed={c === "Tutte" ? "true" : "false"}
				class="aria-pressed:bg-primary aria-pressed:text-primary-foreground"
				>
				<Icona />{c}
				</Button>
			);
			})}
		</div>

	</div>


    <div id="griglia" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
		{
			wishlist.map(({ data }) => {
				const Icona = iconaDi(data.categoria);
				return (
					<div
						data-voce
						data-nome={data.nome}
						data-testo={`${data.nome} ${data.categoria} ${data.note ?? ""}`.toLowerCase()}
						data-categoria={data.categoria}
						data-prezzo={data.prezzo ?? ""}
						data-priorita={data.priorità}			
					>
						<Card  class="h-full relative  hover:scale-105 hover:z-10 transition-all duration-100">
							{data.immagine && (
								<Badge tone="primary-accent" appearance="frosted" size="lg" class="absolute left-0 ml-2 mt-2"> <Stack/> QT. {data.quantità}</Badge>
								
								<img
									src={`data:image/jpeg;base64,${data.immagine}`}
									alt={data.nome}
									loading="lazy"
									class="aspect-square w-full object-cover"
								/>

								<Badge tone="primary-accent" appearance="frosted" size="lg" class="absolute right-0 mr-2 mt-2"> <Icona/> {data.categoria}</Badge>
							)}
							
							<CardHeader>
								<CardTitle>{data.nome}</CardTitle>
								<CardDescription class="flex flex-row justify-center text-center">
									<p>
										{data.publisher}
										{
											data.artista &&
											" - " + data.artista
										}
									</p>
								</CardDescription>
							</CardHeader>
							
							<CardContent class="h-full">
								{data.note && <p>{data.note}</p>}
							</CardContent>
							
							<CardFooter class="flex flex-col">
								<div class="flex flex-row justify-between w-full">
									<span class="flex flex-row justify-center items-center gap-5 align-middle py-5">
										<Star></Star> Priorità: {data.priorità}/5
									</span>
									{
										data.prezzo
										? <p class="my-4 font-semibold text-2xl">{data.prezzo}{data.valuta}</p>
										: <p class="my-4 font-semibold text-2xl">N/A</p>
									}							
								</div>
								{ 
									data.link && 
									<Button 
										href={data.link} 
										target="_blank" 
										size="lg" 
										rel="noopener"
										size="lg"
										class="w-full static after:absolute after:inset-0 after:z-10"
									> 
										Vedi
										<ExternalLink /> 
									</Button> 
								}
							</CardFooter>            
						</Card>
					</div>
				)
      		}
		)}
    </div>

    <p id="vuoto" hidden class="mt-8 text-center">Nessun risultato.</p>
  </section>
</Layout>

<script>
  type Confronto = (a: HTMLElement, b: HTMLElement) => number;

  // Elementi
  const input = document.querySelector<HTMLInputElement>("#cerca");
  const griglia = document.querySelector<HTMLElement>("#griglia");
  const voci = document.querySelectorAll<HTMLElement>("[data-voce]");
  const bottoni = document.querySelectorAll<HTMLElement>("[data-filtro]");
  const vuoto = document.querySelector<HTMLElement>("#vuoto");
  const ordina = document.querySelector<HTMLElement>("#ordina");

  // Filtro: ricerca + categoria
  let categoria = "";

  function aggiorna() {
    const q = input?.value.trim().toLowerCase() ?? "";
    let visibili = 0;
    voci.forEach((voce) => {
      const okTesto = voce.dataset.testo?.includes(q) ?? false;
      const okCategoria = !categoria || voce.dataset.categoria === categoria;
      voce.hidden = !(okTesto && okCategoria);
      if (!voce.hidden) visibili++;
    });
    if (vuoto) vuoto.hidden = visibili > 0;
  }

	// Ordinamento
	const prezzo = (el: HTMLElement) =>
		el.dataset.prezzo ? Number(el.dataset.prezzo) : null;

	const perNome: Confronto = (a, b) =>
		(a.dataset.nome ?? "").localeCompare(b.dataset.nome ?? "", "it");

	const perPrezzo = (verso: 1 | -1): Confronto => (a, b) => {
		const pa = prezzo(a);
		const pb = prezzo(b);
		if (pa === null && pb === null) return 0;
		if (pa === null) return 1;
		if (pb === null) return -1;
		return (pa - pb) * verso;
	};

	const criteri: Record<string, Confronto> = {
		priorita: (a, b) => Number(a.dataset.priorita) - Number(b.dataset.priorita),
		categoria: (a, b) => (a.dataset.categoria ?? "").localeCompare(b.dataset.categoria ?? "", "it"),
		"prezzo-asc": perPrezzo(1),
		"prezzo-desc": perPrezzo(-1),
	};

	function applicaOrdine(valore: string) {
		const criterio = criteri[valore];
		if (!griglia || !criterio) return;
		[...voci]
		.sort((a, b) => criterio(a, b) || perNome(a, b))
		.forEach((el) => griglia.appendChild(el));
	}

	// Eventi
	input?.addEventListener("input", aggiorna);

	bottoni.forEach((b) =>
		b.addEventListener("click", () => {
		categoria = b.dataset.filtro ?? "";
		bottoni.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
		aggiorna();
		})
	);

	const iconeOrdina = document.querySelectorAll<HTMLElement>("[data-icona-ordina]");

	ordina?.addEventListener("starwind:value-change", (e) => {
		const valore = (e as CustomEvent).detail.value;
		iconeOrdina.forEach((i) => (i.hidden = i.dataset.iconaOrdina !== valore));
		applicaOrdine(valore);
	}); 

	
</script>