---
// src/pages/index.astro
// Home: breve presentazione e collegamenti alle pagine di src/data/sito.ts, divise per gruppo.
// I testi della presentazione sono provvisori.
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/starwind/button";
import { Card, CardHeader, CardTitle, CardDescription, CardFooter } from "@/components/starwind/card";
import Logo from "@/assets/logo.svg";
import { GRUPPI, PAGINE, SITO } from "@/data/sito";
import ArrowDown from "@tabler/icons/outline/arrow-down.svg";
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import BrandGithub from "@tabler/icons/outline/brand-github.svg";
---

<Layout>
  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
    <!-- Presentazione -->
    <div class="flex flex-col items-center gap-6 text-center">
      <Logo class="text-primary size-20" aria-hidden="true" />
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        Ciao, benvenuto su <span class="from-primary to-secondary-accent bg-linear-to-r bg-clip-text text-transparent">{SITO.nome}</span>
      </h1>
      <p class="text-muted-foreground max-w-2xl text-lg">
        Questo è il mio piccolo angolo di internet: un posto dove raccogliere progettini, esperimenti e qualche pagina
        personale. Niente di troppo serio, soprattutto cose che mi sono servite e che magari possono servire anche a
        qualcun altro.
      </p>
      <p class="text-muted-foreground max-w-2xl">
        Quando non sto smanettando con codice ed elettronica, probabilmente sto ascoltando un vinile, giocando a un gioco
        da tavolo o leggendo un manga.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <Button href="#pagine" variant="primary" size="lg">Esplora il sito <ArrowDown /></Button>
        <Button href={SITO.github} target="_blank" rel="noopener" variant="outline" size="lg">
          <BrandGithub /> GitHub
        </Button>
      </div>
    </div>

    <!-- Pagine del sito, divise per gruppo -->
    <div id="pagine" class="mt-20 flex scroll-mt-24 flex-col gap-14">
      {
        GRUPPI.map(({ nome, descrizione, icona: IconaGruppo }) => (
          <section>
            <h2 class="flex items-center gap-2 text-2xl font-bold">
              <IconaGruppo class="text-primary-accent size-6" /> {nome}
            </h2>
            <p class="text-muted-foreground mt-1">{descrizione}</p>

            <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {PAGINE.filter((pagina) => pagina.gruppo === nome).map(({ percorso, titolo, descrizione, icona: Icona }) => (
                <Card class="hover:ring-primary/50 relative transition-shadow hover:shadow-lg">
                  <CardHeader>
                    <div class="bg-accent text-accent-foreground mb-2 grid size-11 place-items-center rounded-lg">
                      <Icona class="size-6" />
                    </div>
                    <CardTitle>{titolo}</CardTitle>
                    <CardDescription>{descrizione}</CardDescription>
                  </CardHeader>
                  <CardFooter class="mt-auto">
                    <Button href={percorso} variant="ghost" class="text-primary-accent after:absolute after:inset-0">
                      Apri <ArrowRight />
                    </Button>
                  </CardFooter>
                </Card>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</Layout>
